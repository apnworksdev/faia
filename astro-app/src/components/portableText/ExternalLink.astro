---
import type { Mark, Props as PortableTextNodeProps } from "astro-portabletext/types";

type Props = PortableTextNodeProps<
  Mark<{
    href?: string;
  }>
>;

const { node } = Astro.props as Props;
const href = node.markDef?.href;
---

<a href={href} target="_blank" rel="noopener noreferrer"><slot /></a>
