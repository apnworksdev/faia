---
export const prerender = false;

import PortableTextContent from "../components/portableText/PortableTextContent.astro";
import Layout from "../layouts/Layout.astro";
import { getLanding } from "../utils/sanity";
import "../styles/landing.css";

const language = Astro.url.searchParams.get("lang") || "en";
const landing = await getLanding(language);
---

<Layout title="Faiā" language={language}>
  <section class="landing">
    {landing ? (
      <div class="landing-container">
        {landing.headline && (
          <p class="landing-headline">{landing.headline}</p>
        )}
        {landing.mission && landing.mission.length > 0 && (
          <div class="landing-section">
            <h2 class="landing-section-title">{landing.missionTitle || "Mission"}</h2>
            <div class="landing-content">
              <PortableTextContent value={landing.mission} openLinksInNewTab />
            </div>
          </div>
        )}
        {landing.methods && landing.methods.length > 0 && (
          <div class="landing-section">
            <h2 class="landing-section-title">{landing.methodsTitle || "Methods"}</h2>
            <div class="landing-content">
              <PortableTextContent value={landing.methods} openLinksInNewTab />
            </div>
          </div>
        )}
        {landing.extra && landing.extra.length > 0 && (
          <div class="landing-section">
            <h2 class="landing-section-title">{landing.extraTitle || "Extra"}</h2>
            <div class="landing-content">
              <PortableTextContent value={landing.extra} openLinksInNewTab />
            </div>
          </div>
        )}
        {landing.contact && landing.contact.length > 0 && (
          <div class="landing-section">
            <h2 class="landing-section-title">Contact</h2>
            <nav class="landing-content landing-links">
              {landing.contact.map((link) => (
                <a class="landing-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.title || link.url}</a>
              ))}
            </nav>
          </div>
        )}
      </div>
    ) : (
      <p class="landing-empty">No landing content yet. Add content in Sanity Studio.</p>
    )}

    <div class="landing-section landing-coming-soon-section">
      <div class="landing-content">
        <p class="landing-coming-soon">Complete website coming soon.</p>
      </div>
    </div>
  </section>
</Layout>
